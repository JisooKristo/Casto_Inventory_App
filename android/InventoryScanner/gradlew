##  See the License for the project's license file.
##
##  This file is a placeholder to allow the project to be opened by Gradle wrapper.
##
##############################################################################

if [ -z "$APP_HOME" ]; then
  APP_HOME=$(cd "$(dirname "$0")" && pwd)
fi

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -f "$CLASSPATH" ]; then
  "$JAVA_HOME/bin/java" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
else
  echo "Gradle wrapper not found. Please install Gradle or use the Android Studio wrapper." >&2
  exit 1
fi
